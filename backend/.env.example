# Server Port (default: 3001)
PORT=3001

# GitHub Personal Access Token (Optional, but recommended)
# Unauthenticated requests are limited to 60/hr.
# A token increases this to 5,000 requests/hr.
# Generate one at: https://github.com/settings/tokens?type=beta (fine-grained token, public data only)
GITHUB_TOKEN=

# Allowed CORS Origin (default: * for all origins)
ALLOWED_ORIGIN=*
